{
  "name": "ghcp-video-content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @ghcp/content-cli content build",
    "content": "pnpm --filter @ghcp/content-cli content",
    "typecheck": "pnpm -r typecheck",
    "validate": "pnpm --filter @ghcp/content-cli content validate",
    "test": "pnpm -r test && node --test \"workshops/ghcp-dev-hack/artifacts/leaderboard-kit/test/leaderboard.test.mjs\" \"workshops/ghcp-dev-hack/content/modules/01-foundations/token-cache-cli-motion/sequence.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "slidev-theme-ghcp": "workspace:*",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
